{
  "manifest_version": 3,
  "name": "Claude Quick Ask",
  "version": "1.0.0",
  "description": "選択したテキストをClaudeに自動送信",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}

